<% layout("/layouts/boilerplate") %>

<section class="home-hero">
  <div class="hero-content">
    <p class="eyebrow">Stay curious</p>
    <h1>Make room for<br /><em>better stories.</em></h1>
    <p>
      Handpicked stays for slow mornings, bold plans, and everything in between.
    </p>
    <a class="btn btn-light hero-button" href="/listings"
      >Explore stays <i class="fa-solid fa-arrow-right"></i
    ></a>
  </div>
  <div class="hero-note">
    <span>01</span><span>Places worth<br />remembering</span>
  </div>
</section>
<section class="home-intro">
  <p class="eyebrow">The Hotel4u edit</p>
  <h2>A more personal way to travel.</h2>
  <p>
    Browse stays with character, then sign in to add a place of your own to the
    collection.
  </p>
</section>

<section class="home-discover">
  <div class="home-section-heading">
    <div>
      <p class="eyebrow">Find your feeling</p>
      <h2>Go where the day<br /><em>takes you.</em></h2>
    </div>
    <a class="text-link" href="/listings"
      >View all stays <i class="fa-solid fa-arrow-right"></i
    ></a>
  </div>
  <div class="mood-grid">
    <a class="mood-card mood-card-large" href="/listings?location=Goa">
      <img
        src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1000&q=85"
        alt="Tropical beach getaway"
      />
      <span
        ><small>01</small> Sun-soaked escapes
        <i class="fa-solid fa-arrow-up-right-from-square"></i
      ></span>
    </a>
    <a class="mood-card" href="/listings?location=Manali">
      <img
        src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=900&q=85"
        alt="Mountain retreat"
      />
      <span
        ><small>02</small> Mountain quiet
        <i class="fa-solid fa-arrow-up-right-from-square"></i
      ></span>
    </a>
    <a class="mood-card" href="/listings?location=Udaipur">
      <img
        src="https://images.unsplash.com/photo-1548013146-72479768bdaa?auto=format&fit=crop&w=900&q=85"
        alt="Cultural city stay"
      />
      <span
        ><small>03</small> Stories in the city
        <i class="fa-solid fa-arrow-up-right-from-square"></i
      ></span>
    </a>
  </div>
</section>

<section class="home-values">
  <div class="home-section-heading">
    <div>
      <p class="eyebrow">Travel, considered</p>
      <h2>Small details.<br /><em>Better stays.</em></h2>
    </div>
    <p class="home-values-copy">
      Hotel4u brings thoughtful places and curious people together, so planning
      feels less like a task and more like the beginning of the trip.
    </p>
  </div>
  <div class="value-grid">
    <article>
      <span>01</span><i class="fa-solid fa-compass"></i>
      <h3>Choose your somewhere</h3>
      <p>Search by place, price, or simply the kind of day you want to have.</p>
    </article>
    <article>
      <span>02</span><i class="fa-regular fa-heart"></i>
      <h3>Save what stays with you</h3>
      <p>Keep a private collection of places you would love to return to.</p>
    </article>
    <article>
      <span>03</span><i class="fa-solid fa-key"></i>
      <h3>Make it real</h3>
      <p>
        Book a stay, leave a review, and help the next traveler choose well.
      </p>
    </article>
  </div>
</section>

<section class="home-cta">
  <div>
    <p class="eyebrow">Your next chapter</p>
    <h2>Somewhere good<br /><em>is waiting.</em></h2>
  </div>
  <div class="home-cta-actions">
    <a class="btn btn-light hero-button" href="/listings"
      >Start exploring <i class="fa-solid fa-arrow-right"></i
    ></a>
    <a class="home-cta-secondary" href="/signup"
      >Have a stay to share? Join as a host.</a
    >
  </div>
</section>
