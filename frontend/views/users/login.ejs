<% layout("/layouts/boilerplate") %>

<section class="auth-page">
  <div class="auth-panel auth-panel-copy">
    <p class="eyebrow">Welcome back</p>
    <h1>Find your next stay.</h1>
    <p class="auth-lede">
      Keep your favorite escapes close and share the places that make a trip
      worth taking.
    </p>
    <div class="auth-stat-row">
      <span><strong>01</strong> curated stays</span>
      <span><strong>24/7</strong> travel inspiration</span>
    </div>
  </div>
  <div class="auth-panel auth-form-panel">
    <p class="eyebrow">Member access</p>
    <h2>Sign in to Hotel4u</h2>
    <p class="muted-copy">Use your Hotel4u username and password.</p>
    <form
      action="/login"
      method="post"
      class="auth-form needs-validation"
      novalidate
    >
      <label for="username">Username</label>
      <input
        id="username"
        name="username"
        type="text"
        autocomplete="username"
        required
      />
      <div class="invalid-feedback">Enter your username.</div>
      <label for="password">Password</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
      />
      <div class="invalid-feedback">Enter your password.</div>
      <button class="btn btn-dark w-100 auth-submit" type="submit">
        Sign in <i class="fa-solid fa-arrow-right"></i>
      </button>
    </form>
    <p class="auth-switch">
      New to Hotel4u? <a href="/signup">Create an account</a>
    </p>
  </div>
</section>
