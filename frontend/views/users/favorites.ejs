<% layout("/layouts/boilerplate") %>

<section class="profile-header">
  <p class="eyebrow">Saved for later</p>
  <h1>Your favorites</h1>
  <p class="muted-copy">The stays you want to come back to.</p>
</section>
<nav class="profile-tabs" aria-label="Profile sections">
  <a href="/profile">My stays</a
  ><a class="active" href="/profile/favorites">Favorites</a
  ><a href="/profile/bookings">Bookings</a>
</nav>
<section class="profile-section">
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1">
    <% if (!favorites.length) { %>
    <p class="muted-copy">Save a stay and it will appear here.</p>
    <% } %>
    <% for (let listing of favorites) { %><a
      class="listing-link"
      href="/listings/<%= listing._id %>"
      ><div class="card listing-card">
        <img
          class="card-img-top"
          src="<%= listing.image.url %>"
          alt="<%= listing.title %>"
        />
        <div class="card-body">
          <strong><%= listing.title %></strong><br />&#8377;
          <%= listing.price.toLocaleString('en-IN') %>
          / night
        </div>
      </div></a
    ><% } %>
  </div>
</section>
