<% layout("/layouts/boilerplate") %>
    <% const priceDisplay = (listing.price != null) ?
  listing.price.toLocaleString("en-IN") : "N/A"; %>
    <div class="row">
    <div class="col-8 offset-3">
        <br>
      <h3><%= listing.title %> </h3>
    </div>
      <div class="card col-6 offset-3 show-edit listing-card">
        <img
          src="<%= (listing.image && typeof listing.image === 'object' && listing.image.url) ? listing.image.url : (listing.image && typeof listing.image === 'string' ? listing.image : '/css/no-photo.png') %>"
          class="card-img-top show-img"
          alt="listing_image"
        />
        <div class="card-body">
          <% const averageRating = listing.reviews.length ? (listing.reviews.reduce((sum, review) => sum + review.rating, 0) / listing.reviews.length).toFixed(1) : null; %>
          <p class="card-text">
            <%= listing.description %> <br>
            &#8377;
          <%= priceDisplay %> <br>
          <%= listing.location %> <br>
          <%= listing.country %> <br>
          <% if (averageRating) { %><span class="rating-line">★ <%= averageRating %> · <%= listing.reviews.length %> reviews</span><% } %>
        </p>
        </div>
      </div>
      <br /><br>
      <% if (currentUser) { %>
      <div class="btns">
        <div class="listing-owner-actions">
        <% if (listing.owner && listing.owner._id.equals(currentUser._id)) { %>
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit</a>
        <form method="POST" action="/listings/<%=listing._id %>?_method=DELETE" >
            <button class="btn btn-dark">Delete</button>
        </form>
        <% } %>
        </div>
        <form method="POST" action="/listings/<%= listing._id %>/favorite"><button class="btn btn-outline-dark" type="submit"><%= (currentUser.favorites || []).some((favorite) => favorite.equals(listing._id)) ? 'Remove favorite' : 'Save favorite' %></button></form>
      </div>
      <% } %>
      <br />
    </div>
    <div class="col-8 offset-3 mb-3">
      <hr>
      <h4>Leave a Review</h4>
      <% if (!currentUser) { %>
      <p class="muted-copy"><a href="/login">Sign in</a> to share your experience.</p>
      <% } else { %>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" min="'1" max="5" id="rating" name="review[rating]" class="form-range" >
        </div>
        <div class="mb-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
          <div class="invalid-feedback">
            please add some comments for review
          </div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
      </form>
      <% } %>
      <hr>

      <% if (currentUser) { %>
      <div class="booking-panel"><div><p class="eyebrow">Make it yours</p><h4>Book this stay</h4><p class="muted-copy">From &#8377; <%= priceDisplay %> per night</p></div><form action="/listings/<%= listing._id %>/book" method="post" class="booking-form"><input type="date" name="checkIn" required /><input type="date" name="checkOut" required /><input type="number" name="guests" min="1" max="20" value="1" required /><button class="btn btn-dark" type="submit">Request booking</button></form></div>
      <% } %>

      <p><b>All reviews</b></p>
      <div class="row">
      <% for(review of listing.reviews) { %>
        <div class="card col-5 mb-3 ms-3">
          <div class="card-body">
            <h5 class="card-title"><%= review.author ? review.author.username : 'Hotel4u guest' %></h5>
            <p class="card-text"><%= review.comment %></p>
            <p class="card-text"><%= review.rating %> star</p>
          </div>
          <% if (currentUser && review.author && review.author._id.equals(currentUser._id)) { %><form class="mb-3" method="POST" action="/listings/<%=listing._id %>/reviews/<%= review._id %>?_method=DELETE">
            <button class="btn btn-sm btn-dark">delete</button>
          </form>
          <% } %>
        </div>
      <% } %>
      </div>
      <% if (recommendations && recommendations.length) { %>
      <section class="recommendation-section">
        <div class="section-heading"><div><p class="eyebrow">Smart suggestions</p><h4>You may also like</h4></div><span class="muted-copy">Picked for this stay</span></div>
        <div class="row row-cols-lg-3 row-cols-md-3 row-cols-1">
          <% for (let suggestion of recommendations) { %>
          <a class="listing-link" href="/listings/<%= suggestion._id %>">
            <div class="card listing-card recommendation-card">
              <img class="card-img-top" src="<%= suggestion.image && suggestion.image.url ? suggestion.image.url : '/css/no-photo.png' %>" alt="<%= suggestion.title %>" />
              <div class="card-body"><strong><%= suggestion.title %></strong><br /><span class="listing-location"><%= suggestion.location %>, <%= suggestion.country %></span><br />&#8377; <%= suggestion.price.toLocaleString('en-IN') %> / night</div>
            </div>
          </a>
          <% } %>
        </div>
      </section>
      <% } %>
    </div>
  </div>

